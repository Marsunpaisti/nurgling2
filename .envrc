jdk_root="/c/Program Files/Eclipse Adoptium"

shopt -s nullglob
jdks=("$jdk_root"/jdk-25*)
shopt -u nullglob

if [[ ${#jdks[@]} -eq 0 ]]; then
  echo "No Temurin/Eclipse Adoptium JDK 25 installation found under $jdk_root" >&2
  exit 1
fi

jdk="$(printf '%s\n' "${jdks[@]}" | sort -Vr | sed -n '1p')"

export JAVA_HOME="$(cygpath -w "$jdk")"
PATH_add "$jdk/bin"
